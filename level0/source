#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(int argc, char **argv) {
	(void)argc;

	if (atoi(argv[1]) == 0x1a7) {
		char *arg0 = strdup("/bin/sh");
		char *args[] = {arg0, NULL};
		gid_t egid = getegid();
		uid_t euid = geteuid();
		setresgid(egid, egid, egid);
		setresuid(euid, euid, euid);
		execv("/bin/sh", args);
	}

	fwrite("No !\n", 1, 5, stderr);
	return 0;
}
