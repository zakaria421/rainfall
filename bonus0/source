#include <stdio.h>
#include <string.h>
#include <unistd.h>

static const char kPrompt[] = "-";     // 0x80486a0 (prompt string)
static const char kSep[] = " ";        // 0x80486a4 (2-byte separator)

static void p(char *dst, const char *prompt) {
	char buf[0x1000];
	char *nl;

	puts(prompt);
	read(0, buf, sizeof(buf));
	nl = strchr(buf, '\n');
	if (nl) {
		*nl = '\0';
	}

	// Copies at most 0x14 bytes into dst.
	strncpy(dst, buf, 0x14);
}

static void pp(char *out) {
	char a[0x14];
	char b[0x14];
	size_t len;

	p(a, kPrompt);
	p(b, kPrompt);

	strcpy(out, a);
	len = strlen(out);

	// Append 2 bytes from the separator constant.
	*(unsigned short *)(out + len) = *(const unsigned short *)kSep;

	strcat(out, b);
}

int main(void) {
	char out[0x40];

	pp(out + 0x16);
	puts(out + 0x16);
	return 0;
}






