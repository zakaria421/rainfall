 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 #include <time.h>

 typedef struct s_entry {
 	int id;
 	char *str;
 } t_entry;

 static char g_buffer[0x44];

 static const char g_format[] = "%s - %d\n";
 static const char g_path[] = "/home/user/level8/.pass";
 static const char g_mode[] = "r";
 static const char g_done[] = "~~";

 static void m(void) {
 	printf(g_format, g_buffer, (int)time(NULL));
 }

 int main(int argc, char **argv) {
 	t_entry *first;
 	t_entry *second;
 	FILE *file;

 	if (argc < 3) {
 		return 0;
 	}

 	first = (t_entry *)malloc(8);
 	first->id = 1;
 	first->str = (char *)malloc(8);

 	second = (t_entry *)malloc(8);
 	second->id = 2;
 	second->str = (char *)malloc(8);

 	strcpy(first->str, argv[1]);
 	strcpy(second->str, argv[2]);

 	file = fopen(g_path, g_mode);
 	fgets(g_buffer, sizeof(g_buffer), file);
 	puts(g_done);
 	return 0;
 }
