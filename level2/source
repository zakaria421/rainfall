#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include <unistd.h>

extern char *gets(char *);

static void p(void) {
    char buffer[76];
    uintptr_t return_addr;
    char *dup;

    fflush(stdout);
    gets(buffer);

    return_addr = (uintptr_t)__builtin_return_address(0);
    if ((return_addr & 0xB0000000u) == 0xB0000000u) {
        printf("(%p)\n", (void *)return_addr);
        _exit(1);
    }

    puts(buffer);
    dup = strdup(buffer);
    (void)dup;
}

int main(void) {
    p();
    return 0;
}
